# ==================== CORE / RUNTIME ====================
NODE_ENV=development

# ==================== NEXTAUTH ====================
NEXTAUTH_SECRET=change_me_in_production
NEXTAUTH_URL=http://localhost:3001

# ==================== BACKEND API ====================
# URL base del API Nest (incluye /api/v1 cuando aplica).
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
# Opcional: URL solo servidor (rutas API de NextAuth / server actions). Si no se define, se usa NEXT_PUBLIC_API_URL.
# BACKEND_API_URL=http://localhost:3000/api/v1
# NEXTAUTH_BACKEND_URL=http://localhost:3000/api/v1

# ==================== APP METADATA (CLIENT) ====================
