# ==================== CORE / RUNTIME ====================
NODE_ENV=development

# ==================== NEXTAUTH ====================
NEXTAUTH_SECRET=your-super-secret-key-change-in-production
NEXTAUTH_URL=http://localhost:3002

# ==================== BACKEND API ====================
# Debe apuntar al API Nest con sufijo /api/v1 (mismo contrato que el frontend principal).
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
# Opcional: solo para llamadas desde el servidor NextAuth.
# BACKEND_API_URL=http://localhost:3000/api/v1
# NEXTAUTH_BACKEND_URL=http://localhost:3000/api/v1

# ==================== REALTIME (SOCKET.IO) ====================
# Origen WebSocket del backend (sin path; el cliente añade el namespace si aplica).
NEXT_PUBLIC_WS_URL=http://localhost:3000

# ==================== TMS / WEIGHING APP ====================
# Enlace a la pantalla de pesaje (misma app u otra instancia).
# NEXT_PUBLIC_WEIGHING_APP_URL=http://localhost:3002/weighing
