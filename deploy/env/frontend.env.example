# Copiar a deploy/secrets/frontend.env y rellenar. Alineado con frontend/.env.example

# ==================== CORE / RUNTIME ====================
NODE_ENV=production
PORT=3001

# ==================== NEXTAUTH ====================
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3001

# ==================== BACKEND API ====================
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
# BACKEND_API_URL=http://localhost:3000/api/v1
# NEXTAUTH_BACKEND_URL=http://localhost:3000/api/v1

# ==================== CLIENT / MISC (opcional) ====================
# JWT_TOKEN_STORAGE_KEY=paddy_token
# API_TIMEOUT=30000
# NEXT_PUBLIC_APP_NAME=Paddy AyG
# NEXT_PUBLIC_APP_VERSION=
# NEXT_PUBLIC_APP_RELEASE=
