# Copiar a deploy/secrets/cargo.env y rellenar. App TMS en carpeta cargo/ (puerto 3002).
# Alineado con cargo/.env.local.example

# ==================== CORE / RUNTIME ====================
NODE_ENV=production
PORT=3002

# ==================== NEXTAUTH ====================
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3002

# ==================== BACKEND API ====================
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
# BACKEND_API_URL=http://localhost:3000/api/v1
# NEXTAUTH_BACKEND_URL=http://localhost:3000/api/v1

# ==================== REALTIME (SOCKET.IO) ====================
NEXT_PUBLIC_WS_URL=http://localhost:3000

# ==================== TMS / WEIGHING APP ====================
# NEXT_PUBLIC_WEIGHING_APP_URL=http://localhost:3002/weighing
