# Copiar a deploy/secrets/backend.env y rellenar. Formato KEY=value (líneas # ignoradas).
# Alineado con backend/.env.example — producción suele usar NODE_ENV=production

# ==================== CORE / RUNTIME ====================
NODE_ENV=production
PORT=3000

# ==================== DATABASE (MYSQL) ====================
DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=paddy

# ==================== DATABASE SSL (OPTIONAL) ====================
# DATABASE_SSL=true
# DATABASE_SSL_MODE=REQUIRED
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_SSL_CA=

# ==================== DATABASE BACKUP (SCHEDULED MYSQLDUMP) ====================
DATABASE_BACKUP_ENABLED=false
DATABASE_BACKUP_CRON=0 3 * * *
# DATABASE_BACKUP_TIMEZONE=America/Santiago
DATABASE_BACKUP_OUTPUT_DIR=/var/backups/paddy
# DATABASE_BACKUP_MYSQLDUMP_PATH=/usr/bin/mysqldump
# DATABASE_BACKUP_MYSQLDUMP_EXTRA=
DATABASE_BACKUP_RETENTION_DAYS=7

# ==================== JWT ====================
JWT_SECRET=
JWT_EXPIRATION=15m

# ==================== NEXTAUTH (COMPAT / INTEGRATION) ====================
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_DEBUG=false

# ==================== APPLICATION URLS ====================
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
