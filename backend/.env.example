# ==================== CORE / RUNTIME ====================
NODE_ENV=development
PORT=3000

# ==================== DATABASE (MYSQL) ====================
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=change_me
DATABASE_NAME=paddy

# ==================== DATABASE SSL (OPTIONAL) ====================
# DATABASE_SSL=true
# DATABASE_SSL_MODE=REQUIRED
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_SSL_CA=

# ==================== DATABASE BACKUP (SCHEDULED MYSQLDUMP) ====================
# El proceso puede escribir en cualquier ruta absoluta con permisos del usuario del servidor.
# Requiere el cliente MySQL (mysqldump) instalado.
DATABASE_BACKUP_ENABLED=false
# Cron 5 campos: minuto hora día-mes mes día-semana (ej. 0 3 * * * = diario 03:00)
DATABASE_BACKUP_CRON=0 3 * * *
# DATABASE_BACKUP_TIMEZONE=America/Santiago
DATABASE_BACKUP_OUTPUT_DIR=/var/backups/paddy
# DATABASE_BACKUP_MYSQLDUMP_PATH=/usr/bin/mysqldump
# DATABASE_BACKUP_MYSQLDUMP_EXTRA=--set-gtid-purged=OFF
DATABASE_BACKUP_RETENTION_DAYS=7

# ==================== JWT ====================
JWT_SECRET=change_me_in_production
JWT_EXPIRATION=15m

# ==================== NEXTAUTH (COMPAT / INTEGRATION) ====================
NEXTAUTH_SECRET=change_me_in_production
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_DEBUG=false

# ==================== APPLICATION URLS ====================
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
